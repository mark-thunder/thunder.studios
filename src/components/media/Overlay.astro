---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Overlay style. `lines` draws faint vertical rules that fade at the top and foot, and ignores `strength`. */
  variant?: "solid" | "gradient" | "lines";
  /**
   * Tint strength as a percentage.
   *
   * @min 0
   * @max 100
   * @int
   */
  strength?: number;
}

const {
  render = true,
  variant = "solid",
  strength = 50,
  class: className,
  ...rest
} = Astro.props;
---

{
  render && (
    <div
      class:list={["overlay", variant !== "solid" && variant, className]}
      style={`--_strength: ${strength};`}
      {...rest}
    />
  )
}

<style is:global>
  @layer components {
    .overlay {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-color: color-mix(
        in srgb,
        black calc(var(--_strength, 50) / 100 * 80%),
        transparent
      );

      &.lines {
        --_lines: 12;
        pointer-events: none;
        background-color: transparent;
        --_line: color-mix(in lab, var(--border) 40%, transparent);
        background-image: repeating-linear-gradient(
          to right,
          var(--_line) 0 var(--border-width),
          transparent var(--border-width) calc(100% / var(--_lines))
        );
        mask-image: linear-gradient(
          to bottom,
          transparent,
          black 25%,
          black 75%,
          transparent
        );
        @media (width >= 48rem) {
          --_lines: 24;
        }
      }

      &.gradient {
        background-color: transparent;
        background-image: linear-gradient(
          to bottom,
          transparent 46%,
          color-mix(
              in srgb,
              black calc(var(--_strength, 50) / 100 * 68%),
              transparent
            )
            93.5%
        );
      }
    }
  }
</style>
