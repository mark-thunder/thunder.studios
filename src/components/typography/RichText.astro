---
import type { HTMLAttributes } from "astro/types";
import { PortableText } from "astro-portabletext";
import type { TypedObject } from "astro-portabletext/types";
import SanityMedia from "@/components/media/SanityMedia.astro";
import { slotContent } from "@/utils/slots.ts";

type RichTextStyle =
  | "inherit"
  | "display"
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6"
  | "large"
  | "main"
  | "small";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Portable Text from Sanity, drawn in place of the slot. Images and videos inside it are shown with `SanityMedia`. */
  blocks?: TypedObject[];
  /** Type style. */
  variant?: RichTextStyle;
  /**
   * Maximum line length in characters.
   *
   * @min 1
   * @int
   */
  maxWidth?: number;
  /** Draws its headings two sizes smaller, for long reading such as a policy. The outline stays the same. */
  compact?: boolean;
}

const {
  render = true,
  blocks,
  variant = "inherit",
  maxWidth,
  compact = false,
  class: className,
  ...rest
} = Astro.props;

const content = render ? await slotContent(Astro.slots) : "";
---

{
  render && (blocks?.length || content) && (
    <div
      class:list={[
        "text",
        "rich-text",
        variant !== "inherit" && `text-style-${variant}`,
        compact && "compact",
        className,
      ]}
      style={maxWidth ? `--_mw: ${maxWidth}ch;` : undefined}
      {...rest}
    >
      {blocks?.length ? (
        <PortableText
          value={blocks}
          components={{ type: { image: SanityMedia, video: SanityMedia } }}
        />
      ) : (
        <Fragment set:html={content} />
      )}
    </div>
  )
}

<style is:global>
  @layer components {
    .rich-text {
      & :is(h1, h2, h3, h4, h5, h6, p, ul, ol, blockquote, figure, pre, table) {
        margin-top: var(--_margin-top);
        margin-bottom: var(--_margin-bottom);
      }

      & > :first-child,
      & :is(blockquote, li) > :first-child:not(:is(ul, ol)) {
        margin-top: 0;
      }
      & > :last-child,
      & :is(blockquote, li) > :last-child {
        margin-bottom: 0;
      }

      & :is(ul, ol) {
        padding-left: 1.5em;
      }
      & ul {
        list-style-type: disc;
      }
      & ul ul {
        list-style-type: circle;
      }
      & ul ul ul {
        list-style-type: square;
      }
      & ol {
        list-style-type: decimal;
      }
      & li::marker {
        color: color-mix(in lab, currentcolor 60%, transparent);
      }
      & li + li {
        margin-top: var(--space-2);
      }

      & li > :is(ul, ol) {
        margin-block: var(--space-2);
      }

      & blockquote {
        padding-left: var(--space-4);
        border-left: var(--border-width) solid var(--border);
      }

      /* Compact: each heading level takes the type style two steps down. */
      &.compact {
        & h2 {
          font-size: var(--h4);
          line-height: var(--h4-line-height);
          letter-spacing: var(--h4-letter-spacing);
          --_margin-top: var(--h4-margin-top);
          --_margin-bottom: var(--h4-margin-bottom);
        }
        & h3 {
          font-size: var(--h5);
          line-height: var(--h5-line-height);
          letter-spacing: var(--h5-letter-spacing);
          --_margin-top: var(--h5-margin-top);
          --_margin-bottom: var(--h5-margin-bottom);
        }
      }
    }
  }
</style>
