---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. */
  variant?: "default" | "tag";
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = render ? await slotContent(Astro.slots) : "";
---

{
  render && content && (
    <div
      class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
      {...rest}
    >
      {variant === "default" && (
        <span class="eyebrow_marker" aria-hidden="true" />
      )}
      <Tag class="eyebrow_text text-style-main">
        <Fragment set:html={content} />
      </Tag>
    </div>
  )
}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);

      /* A step darker than the mark: small light text needs 4.5:1 on it. */
      &.tag {
        background-color: var(--tag-background, var(--brand-600));
        color: var(--tag-text, var(--brand-text));
        box-shadow: inset 0 0 0 var(--border-width) var(--tag-border, transparent);
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-main);
        /* The pill wraps the whole line, so the text keeps its leading. */
        .eyebrow_text {
          --_trim-top: 0.5lh;
          --_trim-bottom: 0.5lh;
        }
      }
      .eyebrow_marker {
        flex: none;
        width: 0.75rem;
        height: 0.75rem;
        border-radius: var(--radius-round);
        display: var(--eyebrow-marker-display, block);
        background-color: var(--heading-accent);
      }
    }

    /* A label sits closer to the heading it introduces than flowing text does. */
    .eyebrow_wrap + .heading {
      margin-top: var(--space-4);
    }
  }
</style>
