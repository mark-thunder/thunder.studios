---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"dl"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Label and value pairs, in the order they are listed. */
  items: { label: string; value: string }[];
}

const { render = true, items, class: className, ...rest } = Astro.props;
const filled = items.filter(({ value }) => value);
---

{
  render && filled.length > 0 && (
    <dl class:list={["facts_wrap", className]} {...rest}>
      {filled.map(({ label, value }) => (
        <div class="facts_item">
          <dt class="facts_label">{label}</dt>
          <dd class="facts_value">{value}</dd>
        </div>
      ))}
    </dl>
  )
}

<style is:global>
  @layer components {
    .facts_wrap {
      width: 100%;
      margin: 0;
    }

    .facts_item {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding-block: var(--space-5);
      border-top: var(--border-width) solid var(--border);
    }

    .facts_label {
      color: var(--text-2);
    }

    .facts_value {
      margin: 0;
    }
  }
</style>
