---
import Img from "@/components/media/Img.astro";
import NavLink from "@/components/global/NavLink.astro";
import Modal from "@/components/interactive/Modal.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import SocialLinks from "@/components/item/SocialLinks.astro";
import logoWhole from "@/assets/logo/thunder-media.png";
import logoThunder from "@/assets/logo/thunder-media-thunder.png";
import logoMedia from "@/assets/logo/thunder-media-media.png";
import { NAV_LINKS, LEGAL_LINKS } from "@/consts.ts";
import { getBusiness } from "@/utils/business.ts";
import { slotContent } from "@/utils/slots.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Menu style. */
  variant?: "side-panel" | "full-screen";
  /** How the logo comes back with the nav: whole, or one word after the other. */
  logo?: "whole" | "split";
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const {
  render = true,
  variant = "side-panel",
  logo = "whole",
  overlap = false,
} = Astro.props;
const split = logo === "split";
const fullScreen = variant === "full-screen";
const extras = render ? await slotContent(Astro.slots) : "";

const { name } = await getBusiness();
---

{
  render && (
    <header
      class:list={[
        "nav_wrap",
        overlap && "overlap",
        variant !== "side-panel" && variant,
      ]}
    >
      <div class="nav_inner">
        <a
          class:list={["nav_logo", split && "split"]}
          href="/"
          aria-label={name}
        >
          {split ? (
            <Fragment>
              <Img src={logoThunder} transparent loading="eager" />
              <Img src={logoMedia} transparent loading="eager" />
            </Fragment>
          ) : (
            <Img src={logoWhole} transparent loading="eager" />
          )}
        </a>
        <button
          class="nav_toggle"
          type="button"
          aria-label="Menu"
          aria-haspopup="dialog"
          data-modal-open="nav-menu"
        >
          <span class="nav_toggle_icon" />
        </button>
      </div>
      <Modal id="nav-menu" class="nav_menu" variant={variant} label="Menu">
        <nav aria-label="Main">
          <ul class="nav_links">
            {NAV_LINKS.map(({ label, href }, index) => (
              <NavLink
                class={fullScreen ? "text-style-h1" : "text-style-h4"}
                href={href}
                data-modal-close
              >
                {fullScreen && (
                  <span class="nav_number text-style-small" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                )}
                {label}
              </NavLink>
            ))}
          </ul>
        </nav>
        <ButtonWrapper>
          <Button element="link" href="/contact" data-modal-close>
            Request a Session
          </Button>
          <Fragment set:html={extras} />
        </ButtonWrapper>
        <SocialLinks class="margin-top-6" render={!fullScreen} />
        {!fullScreen && (
          <ul class="nav_legal" aria-label="Legal">
            {LEGAL_LINKS.map(({ label, href }) => (
              <li>
                <a
                  class="nav_legal_link text-style-small"
                  href={href}
                  data-modal-close
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </Modal>
    </header>
  )
}

<script>
  import { ScrollTrigger } from "@/utils/motion.ts";

  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  if (nav) {
    ScrollTrigger.create({
      start: 0,
      end: "max",
      onUpdate: (self) => {
        nav.dataset.state =
          self.scroll() < nav.offsetHeight
            ? "top"
            : self.direction === 1
              ? "hidden"
              : "shown";
      },
    });
  }
</script>

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
  </style>
</noscript>

<style is:global>
  @layer components {
    html:has(.nav_wrap) {
      scroll-padding-top: calc(
        var(--nav-height) + var(--border-width) + var(--focus-offset) +
          var(--focus-width)
      );
    }

    html:has(.nav_wrap.overlap) {
      scroll-padding-top: calc(
        var(--nav-height-overlap) + var(--site-margin) * 2 +
          var(--focus-offset) + var(--focus-width)
      );
    }

    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      border-bottom: var(--border-width) solid var(--border);
      transition:
        background-color var(--open-duration) var(--open-ease),
        border-color var(--open-duration) var(--open-ease);

      &.overlap {
        --nav-height: var(--nav-height-overlap);
        position: fixed;
        inset-inline: 0;
        padding-block: var(--site-margin);
        background-color: transparent;
        border-bottom: 0;
      }

      &.overlap[data-state="shown"] {
        background-color: var(--background);
      }

      &[data-state="hidden"]:not(:focus-within, :has(dialog[open])) {
        background-color: transparent;
        border-color: transparent;
        pointer-events: none;

        .nav_logo {
          opacity: 0;
          translate: 0 -100%;
        }

        .nav_logo.split {
          opacity: 1;
          translate: none;
          > .image {
            opacity: 0;
            translate: 0 -0.5em;
          }
          @media (prefers-reduced-motion: no-preference) {
            > .image:first-child {
              transition-delay: 0.2s;
            }
            > .image:last-child {
              transition-delay: 0s;
            }
          }
        }

        .nav_toggle {
          pointer-events: auto;
        }
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-6);
    }

    /* Bar height */
    .nav_logo,
    .nav_toggle {
      min-height: var(--nav-height);
    }

    /* The mark is a raster with white type baked in; on a light surface it
       flips to black and keeps its red. An SVG would read currentcolor instead. */
    html:not(.theme-dark, .theme-brand) .nav_logo > .image {
      filter: invert(1) hue-rotate(180deg);
    }

    .nav_legal {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
      margin-top: var(--space-6);
      padding: 0;
      list-style: none;
    }

    .nav_legal_link {
      color: var(--text-2);
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .nav_logo {
      display: flex;
      align-items: center;
      width: 8rem;
      transition:
        opacity var(--hover-duration) var(--hover-ease),
        translate var(--open-duration) var(--open-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_logo.split {
      display: grid;
      > .image {
        grid-area: 1 / 1;
        width: 100%;
        transition:
          opacity calc(var(--open-duration) * 2.5) var(--open-ease),
          translate calc(var(--open-duration) * 2.5) var(--open-ease);
      }
      @media (prefers-reduced-motion: no-preference) {
        > .image:last-child {
          transition-delay: 0.2s;
        }
      }
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.75rem;
      --_size: 3.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--_size);
      min-height: var(--_size);
      align-self: center;
      color: inherit;
      background-color: var(--background-2);
      border-radius: var(--radius-round);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .nav_wrap.full-screen {
      .modal_body {
        justify-items: center;
        --_alignment: center;
      }

      .nav_links {
        gap: 0;
      }

      .nav_link {
        display: flex;
        align-items: center;
        gap: var(--space-4);
      }
    }

    .nav_number {
      display: inline-flex;
      flex: none;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border: var(--border-width) solid currentcolor;
      border-radius: var(--radius-round);
    }

    .nav_link {
      display: block;
      padding-block: var(--space-2);
      color: var(--text-2);
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        color: var(--text);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }
  }
</style>
