---
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import Card from "@/components/item/Card.astro";
import { icons } from "@/utils/icons.ts";
import { marks } from "@/utils/marks.ts";
import { getStudioServices } from "@/utils/services.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Content layout. */
  variant?: "cards" | "rows";
}

const { render = true, variant = "cards" } = Astro.props;
const rows = variant === "rows";

const services = render ? await getStudioServices() : [];
---

{
  render && services.length > 0 && (
    <>
      <ContentWrapper>
        <Heading
          tag="h2"
          variant={rows ? "h4" : "h2"}
          class="heading-accent"
          maxWidth={rows ? 40 : undefined}
        >
          Podcasts and photos, <em>under one roof.</em>
        </Heading>
      </ContentWrapper>
      <Grid large={rows ? 1 : 3} class={rows ? "services-main_wrap" : undefined}>
        {services.map((service, index) => (
          <Card
            variant={rows ? "row" : "default"}
            icon={rows ? undefined : icons[service.icon]}
            eyebrow={String(index + 1).padStart(2, "0")}
            eyebrowVariant={rows ? "tag" : "default"}
            heading={marks(service.heading)}
            headingTag="h3"
            text={service.text}
            href={service.slug && `/services/${service.slug}`}
            class="heading-accent"
          />
        ))}
      </Grid>
    </>
  )
}

<style is:global>
  @layer components {
    .grid.services-main_wrap {
      --_gap-size: 0;
    }
  }
</style>
