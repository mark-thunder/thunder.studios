---
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import Card from "@/components/item/Card.astro";
import { marks } from "@/utils/marks.ts";
import { getStudioServices } from "@/utils/services.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const services = render ? await getStudioServices() : [];
---

{
  render && services.length > 0 && (
    <>
      <ContentWrapper>
        <Heading tag="h2" variant="h4" class="heading-accent" maxWidth={40}>
          Podcasts and photos, <em>under one roof.</em>
        </Heading>
      </ContentWrapper>
      <Grid large={1} class="services-main_wrap">
        {services.map((service, index) => (
          <Card
            variant="row"
            eyebrow={String(index + 1).padStart(2, "0")}
            eyebrowVariant="tag"
            heading={marks(service.heading)}
            headingTag="h3"
            text={service.text}
            href={service.slug && `/services/${service.slug}`}
            class="heading-accent"
          />
        ))}
      </Grid>
    </>
  )
}

<style is:global>
  @layer components {
    .grid.services-main_wrap {
      --_gap-size: 0;
    }
  }
</style>
