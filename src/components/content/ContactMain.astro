---
import { actions, getActionPath } from "astro:actions";
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Form from "@/components/form/Form.astro";
import Fieldset from "@/components/form/Fieldset.astro";
import Input from "@/components/form/Input.astro";
import Select from "@/components/form/Select.astro";
import Textarea from "@/components/form/Textarea.astro";
import Choice from "@/components/form/Choice.astro";
import FollowUp from "@/components/form/FollowUp.astro";
import { FOLLOW_UPS } from "@/utils/followUps.ts";
import { getOrdered } from "@/utils/ordered.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Content layout. `centered` sets the form in one narrow column under its own heading and animates the sent note. */
  variant?: "form" | "centered";
  /** Verification widget color scheme, to match the surface under it. `inherit` reads the surface as the page loads. Defaults to `dark`. */
  turnstileTheme?: "light" | "dark" | "inherit";
}

const {
  render = true,
  variant = "form",
  turnstileTheme = "dark",
} = Astro.props;

const centered = variant === "centered";
const Wrap = centered ? "div" : Fragment;

const followUps = FOLLOW_UPS.map(({ key, question, placeholder }) => ({
  key,
  question,
  placeholder,
}));

/* The rooms come from the Studio, so a new space shows up here too. */
const studios = [
  ...(await getOrdered("spaces")).map((space) => space.title),
  "Not sure yet",
];

/* Studios charge by the hour or the session (Studio Terms). */
const lengths = [
  "1–2 hours",
  "Half day (4 hours)",
  "Full day (8 hours)",
  "Not sure yet",
];
---

{
  render && (
    <Wrap {...(centered ? { class: "contact-main_wrap" } : {})}>
      <Heading render={centered} tag="h2" variant="h4">
        Get in touch
      </Heading>
      <Form
        name="contact"
        action={getActionPath(actions.contact)}
        successMessage="We got your message and will reply within one business day."
        errorMessage="Your message did not send. Email us directly and we will pick it up there."
        turnstileSiteKey={PUBLIC_TURNSTILE_SITE_KEY}
        turnstileTheme={turnstileTheme}
        animate={centered}
      >
        <Fieldset legend="Your enquiry" legendStyle="hidden">
          <Grid medium={2}>
            <Input
              variant="full-name"
              label="Name"
              name="name"
              placeholder=""
              required
            />
            <Input
              variant="email"
              label="Email"
              name="email"
              placeholder="you@example.com"
              required
            />
          </Grid>
          <Grid medium={2}>
            <Input
              variant="phone"
              label="Phone"
              name="phone"
              placeholder="(903) 555-0000"
            />
            <Select
              label="Studio"
              name="studio"
              placeholder="Which room?"
              options={studios}
              required
            />
          </Grid>
          <Grid medium={2}>
            <Input
              variant="date"
              label="Preferred date"
              name="date"
              autocomplete="off"
            />
            <Select
              label="How long?"
              name="length"
              placeholder="Pick a length"
              options={lengths}
              required
            />
          </Grid>
          <Textarea
            label="Tell us about your session"
            name="message"
            placeholder="What are you recording or shooting, and how many people are coming?"
            minLines={5}
          />
          <FollowUp questions={followUps} />
          <Choice
            name="smsConsent"
            value="yes"
            label="Text me about my session request at the number above. Message and data rates may apply. Reply STOP to opt out. Not required to work with us."
          />
        </Fieldset>
        <ButtonWrapper slot="submit">
          <Button type="submit">Send Message</Button>
        </ButtonWrapper>
        <Paragraph slot="submit" variant="small" maxWidth={48}>
          By sending, you agree to our <a href="/privacy">Privacy Policy</a>.
        </Paragraph>
      </Form>
    </Wrap>
  )
}

<style is:global>
  @layer components {
    .contact-main_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      width: 100%;
      max-width: 48rem;
      margin-inline: auto;
    }
  }
</style>
