---
import { getCollection } from "astro:content";
import Slider from "@/components/interactive/Slider.astro";
import Heading from "@/components/typography/Heading.astro";
import Card from "@/components/item/Card.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /**
   * Most items shown, newest first. Defaults to `8`.
   *
   * @min 1
   * @int
   */
  limit?: number;
}

const { render = true, limit = 8 } = Astro.props;

const [posts, studies] = render
  ? await Promise.all([getCollection("posts"), getCollection("caseStudies")])
  : [[], []];

const items = [
  ...posts.map(({ data }) => ({
    title: data.title,
    image: data.image,
    href: `/blog/${data.slug}`,
    date: data.publishedAt.valueOf(),
  })),
  ...studies.map(({ data }) => ({
    title: data.title,
    image: data.image,
    href: `/work/${data.slug}`,
    date: Date.UTC(Number(data.year) || 0, 0),
  })),
]
  .sort((a, b) => b.date - a.date)
  .slice(0, limit);
---

{
  render && items.length > 0 && (
    <Slider label="Thunder at a glance" xsmall={1.2} medium={2.2} large={3.2}>
      <Heading slot="heading" tag="h2">
        Thunder at a glance
      </Heading>
      {items.map(({ title, image, href }) => (
        <Card
          variant="thumb"
          image={image.url}
          imageAlt={image.alt}
          style={image.focus && `--image-focus: ${image.focus}`}
          heading={title}
          href={href}
        />
      ))}
    </Slider>
  )
}
