---
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

<ContentWrapper render={render} variant="card">
  <Heading tag="h2" class="heading-accent" maxWidth={14}>
    Book a <strong>studio</strong>{" "}
    <em>session.</em>
  </Heading>
  <ButtonWrapper>
    <Button element="link" href="/contact">Request a Session</Button>
  </ButtonWrapper>
</ContentWrapper>
