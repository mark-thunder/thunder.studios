---
import { getCollection } from "astro:content";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Card from "@/components/item/Card.astro";
import { icons } from "@/utils/icons.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Content layout. */
  variant?: "cards" | "numbers";
}

const { render = true, variant = "cards" } = Astro.props;

const steps = render
  ? (await getCollection("process")).sort((a, b) =>
      a.data.step.localeCompare(b.data.step),
    )
  : [];
---

{
  render && steps.length > 0 && variant === "numbers" && (
    <>
      <ContentWrapper>
        <Heading tag="h2" variant="h4" class="heading-accent" maxWidth={40}>
          From first call to <em>final file.</em>
        </Heading>
      </ContentWrapper>
      <Grid medium={2} large={4} class="process-main_wrap">
        {steps.map(({ data }) => (
          <div class="process-main_step">
            <Paragraph
              variant="display"
              class="process-main_number"
              aria-hidden="true"
            >
              {data.step.replace(/\D/g, "")}
            </Paragraph>
            <Heading tag="h3" variant="h5">
              {data.title}
            </Heading>
            <Paragraph>{data.text}</Paragraph>
          </div>
        ))}
      </Grid>
    </>
  )
}
{
  render && steps.length > 0 && variant === "cards" && (
    <>
      <ContentWrapper>
        <Eyebrow>How We Work</Eyebrow>
        <Heading tag="h2" class="heading-accent" maxWidth={14}>
          From first call to <em>final file.</em>
        </Heading>
      </ContentWrapper>
      <Grid medium={2} large={4}>
        {steps.map(({ data }) => (
          <Card
            icon={icons[data.icon]}
            eyebrow={data.step}
            heading={data.title}
            headingTag="h3"
            text={data.text}
            variant="bare"
          />
        ))}
      </Grid>
    </>
  )
}

<style is:global>
  @layer components {
    .grid.process-main_wrap {
      row-gap: var(--space-8);
    }

    .process-main_step {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .process-main_number {
      color: transparent;
      -webkit-text-stroke: 0.015em var(--text);
    }
  }
</style>
