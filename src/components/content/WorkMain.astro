---
import { getCollection } from "astro:content";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Card from "@/components/item/Card.astro";
import { WORK_KINDS } from "@/consts.ts";
import { slotContent } from "@/utils/slots.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Show only this type of work. Unset, every case study shows with its type. */
  kind?: (typeof WORK_KINDS)[number]["kind"];
  /** Content layout. The gallery takes more caption cards in its slot, placed after the case studies. The spotlight sets the newest three as tall cards, stepped, beside the heading in its slot. */
  variant?: "cards" | "gallery" | "spotlight";
  /** Heading level of each case study. Match it to the cards in the slot. Defaults to `h3`. */
  headingTag?: "h2" | "h3";
}

const {
  render = true,
  kind,
  variant = "cards",
  headingTag = "h3",
} = Astro.props;

const studies = render
  ? await getCollection(
      "caseStudies",
      ({ data }) => !kind || data.kind === kind,
    )
  : [];
const slot =
  render && variant !== "cards" ? await slotContent(Astro.slots) : "";
const more = variant === "gallery" ? slot : "";
const spotlight = variant === "spotlight" ? studies.slice(0, 3) : [];
---

{
  render && variant === "gallery" && (studies.length > 0 || more) && (
    <Grid medium={2}>
      {studies.map(({ data }) => (
        <Card
          variant="caption"
          image={data.image.url}
          imageAlt={data.image.alt}
          style={data.image.focus && `--image-focus: ${data.image.focus}`}
          heading={data.title}
          headingTag={headingTag}
          text={`${data.client} · ${data.year}`}
          href={`/work/${data.slug}`}
        />
      ))}
      <Fragment set:html={more} />
    </Grid>
  )
}
{
  render && variant === "cards" && studies.length > 0 && (
    <>
      <ContentWrapper>
        <Eyebrow>Case Studies</Eyebrow>
        <Heading tag="h2" class="heading-accent" maxWidth={14}>
          How the work <em>got made.</em>
        </Heading>
      </ContentWrapper>
      <Grid variant="autofill" maxColumnCount={3} minColumnWidth={18}>
        {studies.map(({ data }) => (
          <Card
            variant="stacked"
            image={data.image.url}
            imageAlt={data.image.alt}
            eyebrow={kind ? undefined : (data.kind ?? undefined)}
            heading={data.title}
            headingTag={headingTag}
            text={data.excerpt}
            meta={`${data.client} · ${data.year}`}
            href={`/work/${data.slug}`}
          />
        ))}
      </Grid>
    </>
  )
}
{
  render && variant === "spotlight" && spotlight.length > 0 && (
    <div class="work-main_spotlight">
      <ContentWrapper class="work-main_header">
        <Fragment set:html={slot} />
      </ContentWrapper>
      <ul class="work-main_list">
        {spotlight.map(({ data }) => (
          <li class="work-main_item">
            <Card
              variant="cover"
              imageRatio="3-4"
              image={data.image.url}
              imageAlt={data.image.alt}
              style={data.image.focus && `--image-focus: ${data.image.focus}`}
              meta={data.title}
              href={`/work/${data.slug}`}
            />
          </li>
        ))}
      </ul>
    </div>
  )
}

<style is:global>
  @layer components {
    .work-main_spotlight {
      width: 100%;
      display: grid;
      gap: var(--space-8) var(--site-gutter);
      @media (width >= 64rem) {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        align-items: start;
      }
    }

    .work-main_header {
      @media (width >= 64rem) {
        grid-column: span 3;
      }
    }

    /* Three to a row from the first, so a missing study leaves its place
       empty rather than stretching the others. The second steps down
       furthest, the third half as far. */
    .work-main_list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
      gap: var(--site-gutter);
      @media (width >= 64rem) {
        grid-column: span 9;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        > :nth-child(2) {
          padding-top: 10rem;
        }
        > :nth-child(3) {
          padding-top: 5rem;
        }
      }
    }

    .work-main_item > .card_wrap {
      border-radius: var(--radius-small);
    }
  }
</style>
