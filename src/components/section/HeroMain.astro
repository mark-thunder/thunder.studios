---
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Overlay from "@/components/media/Overlay.astro";
import { slotContent } from "@/utils/slots.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Small line of text above the heading. Inline markup is rendered. */
  eyebrow?: string;
  /** The page's title. Inline markup is rendered, so `em` sets a line in the serif. */
  heading: string;
  /**
   * Type style of the title, chosen apart from its level. Defaults to `h2`.
   *
   * - `display`, `h1`, `h2` — the heading sizes
   */
  headingVariant?: "display" | "h1" | "h2";
  /**
   * Longest line of the title, in characters, before it wraps. Unset, it
   * fills its column.
   *
   * @min 1
   * @int
   */
  headingMaxWidth?: number;
  /** A line under the title. Inline markup is rendered. */
  text?: string;
  /** Where the title sits. Defaults to `start`. */
  align?: "start" | "center";
  /** Reveal the title as the page opens. Defaults to `true`. */
  animate?: boolean;
}

const {
  render = true,
  eyebrow,
  heading,
  headingVariant = "h2",
  headingMaxWidth,
  text,
  align = "start",
  animate = true,
} = Astro.props;

const buttons = render ? await slotContent(Astro.slots) : "";
---

<Section
  render={render && !!heading}
  class:list={["hero-main_wrap", align === "center" && "centered"]}
  paddingTop="large"
  paddingBottom="medium"
  gap="large"
>
  <Overlay slot="background" variant="lines" />
  <div class:list={["hero-main_layout", align === "center" && "centered"]}>
    <ContentWrapper
      class="hero-main_content"
      centered={align === "center"}
      animate={animate}
    >
      <Eyebrow>
        <Fragment set:html={eyebrow} />
      </Eyebrow>
      <Heading
        tag="h1"
        variant={headingVariant}
        class="heading-accent"
        maxWidth={headingMaxWidth}
      >
        <Fragment set:html={heading} />
      </Heading>
      <Paragraph variant="large" class="heading-accent" maxWidth={44}>
        <Fragment set:html={text} />
      </Paragraph>
      <ButtonWrapper render={!!buttons}>
        <Fragment set:html={buttons} />
      </ButtonWrapper>
    </ContentWrapper>
  </div>
</Section>

<style is:global>
  @layer components {
    .hero-main_wrap {
      justify-content: end;
      overflow: clip;

      &.centered {
        justify-content: center;
      }
    }

    .hero-main_layout {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-8) var(--site-gutter);
      align-items: start;

      .hero-main_content {
        grid-column: span 12;
      }

      @media (width >= 64rem) {
        .hero-main_content {
          grid-column: span 9;
        }
        &.centered .hero-main_content {
          grid-column: 3 / span 8;
        }
      }
    }
  }
</style>
