---
import { getCollection } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import HeroMain from "@/components/section/HeroMain.astro";
import PostsMain from "@/components/content/PostsMain.astro";

const posts = await getCollection("posts");
---

<Layout
  title="Video Production Blog"
  description="How Thunder Media plans, shoots and edits films, event coverage and podcasts, and what each project teaches us."
>
  <!-- Title -->
  <HeroMain
    variant="lines"
    heading="Blog"
    headingVariant="display"
    text="<em>Notes from the set and the edit.</em>"
    align="center"
  />

  <!-- Posts -->
  <Section id="posts" paddingTop="none">
    <ContentWrapper centered render={posts.length === 0}>
      <Paragraph>The first posts are on the way.</Paragraph>
    </ContentWrapper>
    <PostsMain variant="news" />
  </Section>
</Layout>
