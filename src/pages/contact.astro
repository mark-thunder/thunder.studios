---
export const prerender = false;

import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HeroMain from "@/components/section/HeroMain.astro";
import ContactMain from "@/components/content/ContactMain.astro";
---

<Layout
  title="Contact Us: Request a Session"
  chat={false}
  cta={false}
  description="Tell Thunder Studios what you'd like to record or shoot. We reply within one business day with the options that fit."
>
  <!-- Title -->
  <HeroMain
    heading="Contact"
    headingVariant="display"
    text="Tell us what you'd like to record or shoot. <em>We reply within one business day.</em>"
    align="center"
  />

  <!-- Form -->
  <Section paddingTop="none">
    <ContactMain variant="centered" turnstileTheme="inherit" />
  </Section>
</Layout>
