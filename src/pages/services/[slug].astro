---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import HeroMain from "@/components/section/HeroMain.astro";
import WorkMain from "@/components/content/WorkMain.astro";
import ProcessMain from "@/components/content/ProcessMain.astro";
import { marks } from "@/utils/marks.ts";
import { servicePaths } from "@/utils/paths.ts";
import { serviceTiles } from "../_tiles.ts";

export const getStaticPaths = servicePaths;

const { kind, title, heading, text } = Astro.props;
const tile = (await serviceTiles()).find(({ href }) =>
  href.endsWith(Astro.params.slug),
);
---

<Layout title={title} description={text}>
  <!-- Title -->
  <HeroMain
    variant="lines"
    eyebrow="Services"
    heading={marks(heading)}
    headingVariant="h1"
    headingMaxWidth={16}
    text={`<em>${text}</em>`}
    align="center"
  >
    <Button element="link" href="/contact">Book a Discovery Call</Button>
    <Button element="link" href="/services" emphasis="secondary">
      All Services
    </Button>
  </HeroMain>

  <!-- Picture -->
  <Section paddingTop="none" paddingBottom="none" render={!!tile}>
    <ContentWrapper column1Class="ratio-2-1">
      <Img src={tile!.image} alt={tile!.imageAlt} loading="eager" animate />
    </ContentWrapper>
  </Section>

  <!-- Case studies -->
  <Section id="work">
    <WorkMain variant="gallery" kind={kind} />
  </Section>

  <!-- How we work -->
  <Section id="process" paddingTop="none">
    <ProcessMain variant="numbers" />
  </Section>
</Layout>
