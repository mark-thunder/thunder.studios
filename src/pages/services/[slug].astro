---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import HeroMain from "@/components/section/HeroMain.astro";
import standIn from "@/assets/stand-ins/work-nexacore.jpg";
import { marks } from "@/utils/marks.ts";
import { servicePaths } from "@/utils/paths.ts";

export const getStaticPaths = servicePaths;

const { title, heading, text, image } = Astro.props;
---

<Layout title={title} description={text}>
  <!-- Title -->
  <HeroMain
    eyebrow="Services"
    heading={marks(heading)}
    headingVariant="h1"
    headingMaxWidth={16}
    text={`<em>${text}</em>`}
    align="center"
  >
    <Button element="link" href="/contact">Request a Session</Button>
    <Button element="link" href="/services" emphasis="secondary">
      All Services
    </Button>
  </HeroMain>

  <!-- Picture -->
  <Section paddingTop="none">
    <ContentWrapper column1Class="ratio-2-1">
      <Img
        src={image?.url ?? standIn}
        alt={image?.alt ?? ""}
        loading="eager"
        animate
      />
    </ContentWrapper>
  </Section>
</Layout>
