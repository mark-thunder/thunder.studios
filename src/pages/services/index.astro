---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import HeroMain from "@/components/section/HeroMain.astro";
import ServicesMain from "@/components/content/ServicesMain.astro";
import { getPhotos } from "@/utils/photos.ts";

const photos = await getPhotos();
---

<Layout
  title="Podcast Studio & Photography in White Oak, TX"
  description="Record a video or audio podcast, or get headshots taken, at Thunder Studios in White Oak. Our crew runs the cameras, microphones and edit."
>
  <!-- Title -->
  <HeroMain
    heading="Services"
    headingVariant="display"
    text="Record a podcast or get your headshots taken in White Oak. <em>Our crew runs the cameras, microphones and edit, so you can focus on the conversation.</em>"
    align="center"
  >
    <Button element="link" href="/contact">Book a Discovery Call</Button>
  </HeroMain>

  <!-- Services -->
  <Section id="services" paddingTop="none" gap="7">
    <ServicesMain />
  </Section>

  <!-- Picture -->
  <Section paddingTop="none">
    <ContentWrapper column1Class="ratio-2-1">
      <Img src={photos.session.src} animate />
    </ContentWrapper>
  </Section>
</Layout>
