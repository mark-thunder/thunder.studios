# Copy to .env and fill in. `.env` is git-ignored. On Cloudflare the two secrets
# live on the Worker (Settings → Variables & Secrets); the site key is in wrangler.jsonc.

# Cloudflare Turnstile — thunder.media zone → Turnstile → the widget's keys
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Jev (TypeSafe AI) — spam gate. Leave empty to skip the check.
JEV_API_KEY=
